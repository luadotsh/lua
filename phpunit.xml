<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <!--
            Development tooling that only ever runs with its own env flag on,
            and framework scaffolding with no behaviour of ours in it. Counting
            them as uncovered would only ever tempt someone to write a test
            that asserts Laravel still works.
        -->
        <exclude>
            <file>app/Providers/TelescopeServiceProvider.php</file>
            <file>app/Providers/HorizonServiceProvider.php</file>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Pinned off so a run does not depend on whether an SSR server
             happens to be up: with it on and nothing listening, Inertia falls
             back to client rendering silently and the suite passes either way,
             which is a difference no test would report. -->
        <env name="INERTIA_SSR_ENABLED" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="lua_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="STRIPE_SECRET" value=""/>
    </php>
</phpunit>
