APP_ENV=testing
APP_URL=http://lua.test

# routes/site.php is scoped to this domain, and the link fixtures hardcode
# it, so it has to match APP_URL or the marketing routes are not registered
# on the host route() builds.
DOMAIN_MAIN=lua.test
DOMAIN_CNAME=cname.lua.test
APP_KEY=base64:Zfo+2dkSaHvem5LCiZS/baYHv2Pv1vrSc0F2NaF29Ec=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=1440

MAIL_MAILER=log

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

TELESCOPE_ENABLED=false

# Vite
VITE_STRIPE_KEY="${STRIPE_KEY}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
