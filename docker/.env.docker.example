# Lua — Docker environment template.
#
# Copy to .env before the first `docker compose up`. Hostnames below are the
# Compose service names, not localhost: the app talks to its siblings over the
# Compose network.
#
# APP_KEY is generated on first boot in dev. In production it is required and
# the container refuses to start without it — generate one with:
#   docker compose run --rm app php artisan key:generate --show

APP_NAME="Lua"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Server-side rendering. Off: everything this app serves sits behind a login,
# where nothing crawls and nobody shares a link for its preview, so rendering
# on the server costs a second process and a class of silent failure and buys
# nothing. The wiring is intact — set this to true and start the supervisord
# program (or `php artisan inertia:start-ssr`) to turn it back on.
INERTIA_SSR_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database. MySQL is supported too: set DB_CONNECTION=mysql, DB_HOST=mysql,
# DB_PORT=3306. If you do, load the server's timezone tables once — analytics
# buckets use CONVERT_TZ with a named zone, and CONVERT_TZ returns NULL while
# those tables are empty, so every chart reads as zero with no error anywhere:
#
#   mysql_tzinfo_to_sql /usr/share/zoneinfo | mysql -u root -p mysql
#
# Verify with: SELECT COUNT(*) FROM mysql.time_zone_name;   (must be > 0)
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=lua
DB_USERNAME=postgres
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Reverb. Broadcasting is wired but nothing publishes yet; set
# BROADCAST_CONNECTION=reverb once there is an event to send. The VITE_
# copies are what resources/js/echo.ts reads in the browser.
REVERB_APP_ID=1001
REVERB_APP_KEY=lua-reverb-key
REVERB_APP_SECRET=lua-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SENDKIT_API_KEY=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2. Set FILESYSTEM_DISK=r2 to store uploads there.
# R2_ENDPOINT is the S3 API (https://<account-id>.r2.cloudflarestorage.com);
# R2_URL is the public bucket or custom domain files are served from.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_URL=

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# PostHog (optional - product analytics; off by default, self-hosted installs can ignore)
POSTHOG_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

VITE_POSTHOG_ENABLED="${POSTHOG_ENABLED}"
VITE_POSTHOG_API_KEY="${POSTHOG_API_KEY}"
VITE_POSTHOG_HOST="${POSTHOG_HOST}"

# Social sign-in (optional - each provider is hidden until both values are set)
# Social login. A provider needs both the switch and its credentials below:
# with the credentials empty the button is hidden either way.
GOOGLE_AUTH_ENABLED=true
GITHUB_AUTH_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mapbox (optional - powers the analytics map; the card explains itself when unset)
MAPBOX_TOKEN=

# Passport. storage/ is not a persisted volume, so in production supply the
# keys from the environment or every restart invalidates existing API tokens.
# Generate once with: php artisan passport:keys --show
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
